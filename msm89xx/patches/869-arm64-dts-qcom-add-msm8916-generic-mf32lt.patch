--- /dev/null
+++ b/arch/arm64/boot/dts/qcom/msm8916-generic-mf32lt.dts
@@ -0,0 +1,286 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * MF32LT 4G modem stick (XinXun UFI MF32LT): MSM8916, 512 MB RAM, 4 GB eMMC,
+ * 2100 mAh LiPo cell, one physical SIM tray plus two embedded (e)SIMs.
+ *
+ * Ported from the ImmortalWrt openstick-mf32lt target (msm8916-ufi-mf32.dts,
+ * thwc,ufi-mf32); every GPIO role below matches the stock Android DT
+ * (msm8916-mtp 512 MB) recovered from this device:
+ *
+ *   battery gauge    bat_1..bat_4   GPIO19/22/21/20  blue, active high
+ *   status trio      GPIO28 red / GPIO30 green / GPIO29 blue
+ *   Wi-Fi lamp       GPIO27         blue, -> blue:wlan
+ *   power button     GPIO34         active low, reports KEY_POWER
+ *   SIM mux          GPIO24 sim_en (held low by the hog below),
+ *                    GPIO49 tray select, GPIO50/51 eSIM1/eSIM2
+ *                    exposed as gpio-leds, driven by etc/init.d/sim-select
+ *   USB id           GPIO110
+ */
+
+/dts-v1/;
+
+#include "msm8916-ufi.dtsi"
+
+#include <dt-bindings/gpio/gpio.h>
+#include <dt-bindings/leds/common.h>
+#include <dt-bindings/iio/qcom,spmi-vadc.h>
+
+/ {
+	model = "MF32LT 4G Modem Stick";
+	compatible = "mf32lt,generic", "qcom,msm8916";
+
+	/*
+	 * 2100 mAh 4.35 V LiPo cell (3.40 V .. 4.35 V design window).  The
+	 * single 25 C OCV curve comes with the ImmortalWrt port for this
+	 * board; the voltage-mode BMS reports capacity from it.
+	 */
+	battery: battery {
+		compatible = "simple-battery";
+		device-chemistry = "lithium-ion-polymer";
+
+		voltage-min-design-microvolt = <3400000>;
+		voltage-max-design-microvolt = <4350000>;
+		charge-full-design-microamp-hours = <2100000>;
+
+		ocv-capacity-celsius = <25>;
+		ocv-capacity-table-0 = < 4327000 100 >,
+			< 4264000 95 >,
+			< 4187000 90 >,
+			< 4119000 85 >,
+			< 4069000 80 >,
+			< 4022000 75 >,
+			< 3964000 70 >,
+			< 3927000 65 >,
+			< 3890000 60 >,
+			< 3853000 55 >,
+			< 3801000 50 >,
+			< 3778000 45 >,
+			< 3769000 40 >,
+			< 3766000 35 >,
+			< 3760000 30 >,
+			< 3721000 25 >,
+			< 3660000 20 >,
+			< 3608000 16 >,
+			< 3579000 13 >,
+			< 3563000 11 >,
+			< 3548000 10 >,
+			< 3531000 9 >,
+			< 3520000 8 >,
+			< 3514000 7 >,
+			< 3502000 6 >,
+			< 3495000 5 >,
+			< 3489000 4 >,
+			< 3475000 3 >,
+			< 3460000 2 >,
+			< 3444000 1 >,
+			< 3400000 0 >;
+	};
+
+	/* USB id pin: grounded in a host cable, floating as a device. */
+	usb_id: usb-id {
+		compatible = "linux,extcon-usb-gpio";
+		id-gpio = <&tlmm 110 GPIO_ACTIVE_HIGH>;
+		pinctrl-names = "default";
+		pinctrl-0 = <&usb_id_default>;
+	};
+};
+
+/* Persistent kernel log (ramoops) — same region as every other board. */
+&reserved_memory {
+	ramoops@8db00000 {
+		compatible = "ramoops";
+		reg = <0x0 0x8db00000 0x0 0x00100000>;
+		record-size = <0x00040000>;
+		console-size = <0x00040000>;
+		pmsg-size = <0x00040000>;
+		ecc-size = <16>;
+	};
+};
+
+/*
+ * The status trio inherits the ufi.dtsi roles: red = power/modem health,
+ * green = wlan, blue = wan.  The physical Wi-Fi lamp is the separate blue
+ * wifi_s below; the labels stay distinct (green:wlan vs blue:wlan).
+ */
+&led_r {
+	gpios = <&tlmm 28 GPIO_ACTIVE_HIGH>;
+};
+
+&led_g {
+	gpios = <&tlmm 30 GPIO_ACTIVE_HIGH>;
+};
+
+&led_b {
+	gpios = <&tlmm 29 GPIO_ACTIVE_HIGH>;
+};
+
+&{/leds} {
+	bat_1 {
+		label = "bat_1";
+		color = <LED_COLOR_ID_BLUE>;
+		default-state = "off";
+		gpios = <&tlmm 19 GPIO_ACTIVE_HIGH>;
+	};
+
+	bat_2 {
+		label = "bat_2";
+		color = <LED_COLOR_ID_BLUE>;
+		default-state = "off";
+		gpios = <&tlmm 22 GPIO_ACTIVE_HIGH>;
+	};
+
+	bat_3 {
+		label = "bat_3";
+		color = <LED_COLOR_ID_BLUE>;
+		default-state = "off";
+		gpios = <&tlmm 21 GPIO_ACTIVE_HIGH>;
+	};
+
+	bat_4 {
+		label = "bat_4";
+		color = <LED_COLOR_ID_BLUE>;
+		default-state = "off";
+		gpios = <&tlmm 20 GPIO_ACTIVE_HIGH>;
+	};
+
+	wifi_s {
+		color = <LED_COLOR_ID_BLUE>;
+		default-state = "off";
+		function = LED_FUNCTION_WLAN;
+		gpios = <&tlmm 27 GPIO_ACTIVE_HIGH>;
+	};
+
+	/*
+	 * SIM select lines: sim_switch_gpio high picks the physical tray,
+	 * esim1/esim2 pick the embedded cards.  etc/init.d/sim-select applies
+	 * the selection saved in /etc/config/sim (sim | esim1 | esim2);
+	 * /usr/sbin/sim-select is its CLI.  Keep the labels: the init script
+	 * writes /sys/class/leds/<label>/brightness.
+	 */
+	led-sim {
+		label = "sim_switch_gpio";
+		gpios = <&tlmm 49 GPIO_ACTIVE_HIGH>;
+		default-state = "on";
+		retain-state-suspended;
+	};
+
+	led-esim1 {
+		label = "esim1_switch_gpio";
+		gpios = <&tlmm 50 GPIO_ACTIVE_HIGH>;
+		default-state = "off";
+		retain-state-suspended;
+	};
+
+	led-esim2 {
+		label = "esim2_switch_gpio";
+		gpios = <&tlmm 51 GPIO_ACTIVE_HIGH>;
+		default-state = "off";
+		retain-state-suspended;
+	};
+};
+
+&gpio_leds_default {
+	pins = "gpio19", "gpio20", "gpio21", "gpio22", "gpio27",
+	       "gpio28", "gpio29", "gpio30", "gpio49", "gpio50", "gpio51";
+};
+
+/*
+ * Power button (stock key_freset, GPIO34, active low).  Reports KEY_POWER,
+ * so the shared handlers apply: short press = nothing, double press =
+ * reboot, 4 s hold = power off (etc/rc.button/power), one press inside the
+ * preinit window = failsafe.
+ */
+&button_restart {
+	gpios = <&tlmm 34 GPIO_ACTIVE_LOW>;
+	linux,code = <KEY_POWER>;
+	label = "Power";
+};
+
+&button_default {
+	pins = "gpio34";
+	bias-pull-up;
+};
+
+/*
+ * Pack NTC through the PMIC VADC rather than the BMS block (same wiring the
+ * ImmortalWrt port uses); without it the gauge reports no temperature.
+ */
+&pm8916_vadc {
+	channel@30 {
+		reg = <VADC_LR_MUX1_BAT_THERM>;
+		qcom,pre-scaling = <1 1>;
+		qcom,ratiometric;
+		qcom,hw-settle-time = <16000>;
+	};
+};
+
+&pm8916_bms {
+	monitored-battery = <&battery>;
+	power-supplies = <&pm8916_charger>;
+
+	io-channels = <&pm8916_vadc VADC_LR_MUX1_BAT_THERM>;
+	io-channel-names = "batt-therm";
+
+	status = "okay";
+};
+
+/*
+ * pm8916_charger and the pm8916_usbin extcon enabled by msm8916-ufi.dtsi
+ * both claim SPMI register 0x1300 and the usb_vbus interrupt, so only one
+ * can bind (same reasoning as the mf800b).  Bind the charger: it supplies
+ * the EXTCON_USB session-valid signal the MSM HS PHY needs as well as
+ * driving charge.  The fast-charge pair caps the inductor current at 1 A
+ * and the regulation voltage at 4.38 V.
+ */
+&pm8916_usbin {
+	status = "disabled";
+};
+
+&pm8916_charger {
+	monitored-battery = <&battery>;
+
+	qcom,fast-charge-safe-voltage = <4380000>;
+	qcom,fast-charge-safe-current = <1000000>;
+
+	status = "okay";
+};
+
+&sdhc_2 {
+	status = "okay";
+};
+
+&usb {
+	dr_mode = "otg";
+	extcon = <&pm8916_charger>, <&usb_id>;
+};
+
+&usb_hs_phy {
+	extcon = <&pm8916_charger>;
+};
+
+&gpu {
+	status = "okay";
+};
+
+/*
+ * sim_en: the mux enable line, held low exactly as the stock DT and the
+ * ImmortalWrt port do (stock drove it from a modem pinctrl state; a hog
+ * keeps it in GPIO function for good, and nobody writes it at runtime).
+ */
+&tlmm {
+	sim_en {
+		gpio-hog;
+		gpios = <24 GPIO_ACTIVE_HIGH>;
+		output-low;
+		line-name = "sim_en";
+	};
+
+	usb_id_default: usb-id-default {
+		pins = "gpio110";
+		function = "gpio";
+
+		drive-strength = <8>;
+		input-enable;
+		bias-pull-up;
+	};
+};
