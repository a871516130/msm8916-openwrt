+/*
+ * The pack has no current sense, so the only OCV estimate available while
+ * charging is the terminal voltage minus the charge-current lift:
+ *
+ *	vbat = OCV + (I_charge - I_load) * R_pack
+ *
+ * The load term is small on an idle stick and the charger can only report
+ * the programmed charge current, so that is what the correction uses.  The
+ * resistance comes from the device tree ("qcom,charge-ir-mohm") and should
+ * be calibrated on the target: measure vbat right after a charge starts and
+ * again once the current stops, then R = (vbat_charge - vbat_rest) / I.
+ */
+static int pm8916_bms_vm_charge_ocv(struct pm8916_bms_vm_battery *bat,
+				    struct power_supply *psy)
+{
+	union power_supply_propval cur = { 0 };
+	unsigned int drop, ocv = bat->vbat_now;
+
+	if (!bat->charge_ir_mohm)
+		return ocv;
+
+	if (power_supply_get_property_from_supplier(psy,
+			POWER_SUPPLY_PROP_CONSTANT_CHARGE_CURRENT, &cur))
+		return ocv;
+
+	drop = (bat->charge_ir_mohm * cur.intval) / 1000;
+	if (drop >= ocv)
+		return ocv;
+
+	return ocv - drop;
+}
+
+static bool pm8916_bms_vm_is_charging(struct power_supply *psy)
+{
+	union power_supply_propval online = { 0 }, enabled = { 0 };
+
+	if (power_supply_get_property_from_supplier(psy,
+			POWER_SUPPLY_PROP_ONLINE, &online))
+		return false;
+	if (!online.intval)
+		return false;
+
+	if (power_supply_get_property_from_supplier(psy,
+			POWER_SUPPLY_PROP_CHARGE_ENABLED, &enabled))
+		return true;
+
+	return enabled.intval != 0;
+}
+
