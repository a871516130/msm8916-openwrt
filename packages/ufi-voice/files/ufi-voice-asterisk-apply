#!/bin/sh
# ufi-voice-asterisk-apply - write the Asterisk configuration from ufivoice uci.
#
# The SIP accounts live in ufivoice uci (config phone). pjsip.conf,
# extensions.conf, manager.conf and voicemail.conf are GENERATED: edit the
# accounts in the LuCI phone page (Services -> Phone) or with uci, never in the
# files, and run this script afterwards.
#
# Idempotent. Runs at first install (from 91-ufi-voice-asterisk) and from the
# phone page's Apply button.

[ -d /etc/asterisk ] || exit 0

. /lib/functions.sh

# sysupgrade keeps the old /etc/passwd: the asterisk user of the package
# may be missing, and the init script then fails (runs with -U asterisk)
user_exists asterisk || add_group_and_user asterisk
for d in /var/lib/asterisk /var/log/asterisk /var/run/asterisk /var/spool/asterisk; do
	[ -d "$d" ] && chown -R asterisk:asterisk "$d"
done

rnd() { head -c 9 /dev/urandom | hexdump -v -e '/1 "%02x"'; }

# password of <number> in an existing pjsip.conf. Older installs kept the
# accounts only in the generated file; take them over the first time.
old_pw() {
	[ -f /etc/asterisk/pjsip.conf ] || return 0
	awk -v want="$1" '
		/^\[/ { u = "" }
		/^username=/ { sub(/^username=/, ""); u = $0 }
		/^password=/ { sub(/^password=/, ""); if (u == want) p = $0 }
		END { if (p != "") print p }
	' /etc/asterisk/pjsip.conf
}

# --- accounts ------------------------------------------------------------

n_phone=0

fill_password() {
	local num pw
	config_get num "$1" number
	[ -n "$num" ] || return 0
	config_get pw "$1" password
	if [ -z "$pw" ]; then
		pw=$(old_pw "$num")
		[ -n "$pw" ] || pw=$(rnd)
		uci -q set "ufivoice.$1.password=$pw"
	fi
	n_phone=$((n_phone + 1))
}

config_load ufivoice
config_foreach fill_password phone

# nothing configured: the two default phones
if [ "$n_phone" = 0 ]; then
	i=0
	for num in 100 101; do
		i=$((i + 1))
		pw=$(old_pw "$num")
		[ -n "$pw" ] || pw=$(rnd)
		uci -q set "ufivoice.p$i=phone"
		uci -q set "ufivoice.p$i.number=$num"
		uci -q set "ufivoice.p$i.password=$pw"
		n_phone=$((n_phone + 1))
	done
fi

# ring group: every phone, unless the user set one
if [ -z "$(uci -q get ufivoice.main.sip_ring)" ]; then
	ring=""
	build_ring() {
		local num
		config_get num "$1" number
		[ -n "$num" ] && ring="${ring:+$ring&}PJSIP/$num"
	}
	config_load ufivoice
	config_foreach build_ring phone
	[ -n "$ring" ] && uci -q set "ufivoice.main.sip_ring=$ring"
fi

ami=$(uci -q get ufivoice.main.ami_secret)
[ -n "$ami" ] || {
	ami=$(rnd)
	uci -q set "ufivoice.main.ami_secret=$ami"
}

# This script also runs from ufi-voiced's reload handler, which a commit of
# ufivoice itself triggers. Committing unconditionally would loop: commit ->
# reload -> commit. Only commit when the generated defaults actually changed.
[ -n "$(uci -q changes ufivoice)" ] && uci -q commit ufivoice

# keep the distribution's files once, then replace them
for f in pjsip.conf extensions.conf manager.conf voicemail.conf; do
	[ -f /etc/asterisk/$f ] && [ ! -f /etc/asterisk/$f.orig ] &&
		mv /etc/asterisk/$f /etc/asterisk/$f.orig
done

# --- pjsip.conf ----------------------------------------------------------

{
	cat <<'EOT'
; ufi-voice: SIP phones for the mobile line.
; GENERATED by /usr/sbin/ufi-voice-asterisk-apply from /etc/config/ufivoice.
[transport-udp]
type=transport
protocol=udp
bind=0.0.0.0:5060

[phone](!)
type=endpoint
context=ufi-phones
disallow=all
allow=ulaw,alaw
direct_media=no
rtp_symmetric=yes
force_rport=yes
rewrite_contact=yes

[aor](!)
type=aor
; one contact per account: a phone that re-registers from a new port before
; the old registration expires would otherwise be forked twice, and an
; incoming call would pop up twice on the same handset
max_contacts=1
remove_existing=yes
; A suspended iOS client leaves its contact behind (up to an hour) while its
; socket is dead, and Dial() then sends INVITEs into the void for the whole
; 30 s timeout instead of returning CHANUNAVAIL - so the retry loop in
; [ufi-incoming] never gets to ring the phone when it wakes up. Qualify every
; 10 s: a contact that stops answering goes Unavailable, Dial() fails at once
; and the retry loop polls it, so the ring happens within a couple of seconds
; of the client re-registering. The contact is NOT removed: a transient WiFi
; loss would otherwise leave the phone unreachable until it re-registered.
qualify_frequency=10
qualify_timeout=2
EOT

	gen_endpoint() {
		local num pw
		config_get num "$1" number
		config_get pw "$1" password
		[ -n "$num" ] || return 0
		cat <<EOT

[$num](phone)
auth=$num-auth
aors=$num
[$num](aor)
[$num-auth]
type=auth
auth_type=userpass
username=$num
password=$pw
EOT
	}
	config_load ufivoice
	config_foreach gen_endpoint phone
} > /etc/asterisk/pjsip.conf

# --- IVR greeting ----------------------------------------------------------
#
# The IVR menu plays the recording "ufi-phones". No asterisk sound package
# provides one, so take a stock recording that asks the caller for an
# extension number and make it available under that name. A recording that
# already exists is left alone - it may be a user replacement.
#
# Only .gsm is usable here: this build ships format_gsm.so and no other
# sound format module, and codec_gsm turns gsm into the ulaw/alaw the
# phones negotiate.

install_ivr_greeting() {
	local src dst
	dst=/usr/share/asterisk/sounds/ufi-phones.gsm
	[ -f "$dst" ] && return 0
	for src in basic-pbx-ivr-main vm-starmain vm-intro; do
		if [ -f "/usr/share/asterisk/sounds/$src.gsm" ]; then
			cp -f "/usr/share/asterisk/sounds/$src.gsm" "$dst" &&
				chown asterisk:asterisk "$dst" 2>/dev/null
			return 0
		fi
	done
	return 1
}

install_ivr_greeting ||
	echo "ufi-voice-asterisk-apply: warning: no IVR greeting recording found" >&2

# --- extensions.conf -----------------------------------------------------

{
	cat <<'EOT'
; ufi-voice dialplan.
; GENERATED by /usr/sbin/ufi-voice-asterisk-apply from /etc/config/ufivoice.
[general]
static=yes
writeprotect=yes

[ufi-phones]
EOT

	gen_exten() {
		local num
		config_get num "$1" number
		[ -z "$num" ] && return 0
		# Ring this phone; an unanswered (or unregistered) phone falls through to
		# its mailbox.  voicemail() takes the mailbox as its FIRST argument and
		# parses the second as app options, so the context must ride on the
		# mailbox with the "@" separator: voicemail(101@main). A second
		# argument instead turned "101" into option letters ("Unrecognized
		# option") and left the mailbox empty.
		echo "exten => $num,1,Dial(PJSIP/$num,30)"
		echo " same => n,GotoIf(\$[\"\${DIALSTATUS}\" != \"ANSWER\"]?vm)"
		echo " same => n(vm),voicemail($num@main)"
		echo " same => n,Hangup()"
	}
	config_load ufivoice
	config_foreach gen_exten phone

	# *97<mailbox> -> voicemail, *98 -> IVR. Exact / more specific extensions beat
	# the _[0-9+*#]. catch-all below, so they never leave for the mobile network.
	#
	# Many SIP clients map the phone's * key to # (or the user reaches for #
	# on the keypad), so accept # as well: #97<mailbox> and #98 are handled
	# identically. Both are exact/pattern matches and still beat the
	# catch-all.
	cat <<'EOT'
exten => *98,1,Goto(ivr-menu,*98,1)
exten => _*97[0-9].,1,Goto(voicemail-in,${EXTEN},1)
exten => #98,1,Goto(ivr-menu,*98,1)
exten => _#97[0-9].,1,Goto(voicemail-in,${EXTEN},1)
EOT

	cat <<'EOT'
; everything else goes out through the mobile network (ufi-voiced)
exten => _[0-9+*#].,1,Set(UUID=${SHELL(/usr/sbin/ufi-voice-dial ${EXTEN})})
 same => n,GotoIf($["${UUID}" = ""]?fail)
 same => n,Answer()
 same => n,AudioSocket(${UUID},127.0.0.1:9092)
 same => n,Hangup()
 same => n(fail),Congestion(5)

; incoming mobile calls: ufi-voiced originates Local/s@ufi-incoming.
; A phone whose client is suspended (iOS does this to any app in the
; background) has no SIP contact, and Dial() then fails at once with
; CHANUNAVAIL instead of ringing. Retry for 45 s so the phone is rung the
; moment the user opens the client and it registers again.
;
; A decline also comes back as CHANUNAVAIL (the fork to the other account
; failed), so retrying on that alone re-rings a phone the user just rejected.
; Before retrying, check that the target is really unreachable: a phone whose
; contact is "Reachable" is registered and must not be rung again. The checks
; are generated below, one line per phone. DEVICE_STATE() would be the obvious
; function, but func_devstate is a separate module that is not always
; installed - and an unregistered function makes GotoIf fail, which hangs up
; the whole call (the caller then hears "busy"). PJSIP_AOR()/PJSIP_CONTACT()
; ship with chan_pjsip, which this setup always has.
[ufi-incoming]
exten => s,1,Set(UFI_T0=${EPOCH})
 same => n(retry),Dial(${UFI_RING},30)
 same => n,GotoIf($["${DIALSTATUS}" = "ANSWER"]?done)
 same => n,GotoIf($["${DIALSTATUS}" != "CHANUNAVAIL"]?done)
EOT

	gen_guard() {
		local num
		config_get num "$1" number
		[ -n "$num" ] &&
			echo " same => n,GotoIf(\$[\"\${PJSIP_CONTACT(\${PJSIP_AOR($num,contact)},status)}\" = \"Reachable\"]?done)"
	}
	config_load ufivoice
	config_foreach gen_guard phone

	cat <<'EOT'
 same => n,Wait(2)
 same => n,GotoIf($[$[${EPOCH} - ${UFI_T0}] < 45]?retry)
 same => n(done),Hangup()

; ---- voicemail access (*97<mailbox>) and the IVR demo (*98) -------------
; *97100 reaches mailbox 100, *97101 reaches mailbox 101. Mailboxes live in
; the "main" context of voicemail.conf (see below), attached with "@".
; Retrieving uses VoiceMailMain - the "vmmain" alias is not registered by
; app_voicemail, only "VoiceMail" and "VoiceMailMain" are.
[voicemail-in]
; Both the * and # prefix reach a mailbox: the * prefix is the usual one, the
; # prefix covers clients whose * key is mapped to #. ${EXTEN:3} strips the
; 3-character prefix (e.g. *97101 / #97101 -> 101).
exten => _*97[0-9].,1,Answer()
 same => n,VoiceMailMain(${EXTEN:3}@main)
 same => n,Hangup()
exten => _#97[0-9].,1,Answer()
 same => n,VoiceMailMain(${EXTEN:3}@main)
 same => n,Hangup()

[ivr-menu]
; *98 is the IVR menu: play the ufi-phones greeting, wait for digits, then
; route them into ufi-phones - so 100/101 reach those phones (or their
; mailbox when the client is offline) and anything else leaves for the
; mobile network. "*" repeats the menu.
;
; IVRDemo() was used here before, but in asterisk 23 it is a skeleton
; application: it ignores its filename argument for the greeting and plays
; hardcoded "demo-congrats"/"demo-instruct", which this build does not ship.
; The menu was silent. Playback()+WaitExten() has no such dependencies.
;
; WaitExten() leaves EXTEN untouched when the caller just waits, so EXTEN is
; still the entry extension (*98 or s) on timeout - route that to hangup,
; otherwise the call would loop back into the menu forever.
exten => *98,1,Answer()
 same => n(top),Playback(ufi-phones)
  same => n,WaitExten(30)
  same => n,GotoIf($["${EXTEN}" = "*"]?top)
  same => n,GotoIf($["${EXTEN}" = "#"]?top)
  same => n,GotoIf($["${EXTEN}" = "*98"]?end)
  same => n,GotoIf($["${EXTEN}" = "s"]?end)
  same => n,Goto(ufi-phones,${EXTEN},1)
 same => n(end),Hangup()
exten => s,1,Answer()
 same => n,Goto(*98,1)
EOT
} > /etc/asterisk/extensions.conf

# --- voicemail.conf ------------------------------------------------------
#
# The distribution ships a voicemail.conf whose mailboxes are commented out,
# so voicemail(main,N) answers with "No entry in voicemail config file for
# 'main'" and an unanswered call just hangs up. Generate one mailbox per phone
# in the "main" context. The password is 1000 + index (100 -> 1000,
# 101 -> 1001), matching the stock layout.
#
# format=gsm: this asterisk build ships only format_gsm.so (no wav/wav49
# res_format_* module), and an unregistered format makes asterisk log
# "ignoring unknown format" for the whole line.

{
	cat <<'EOT'
; ufi-voice voicemail.
; GENERATED by /usr/sbin/ufi-voice-asterisk-apply from /etc/config/ufivoice.
[general]
format=gsm
serveremail=asterisk
attach=yes
skipms=3000
maxsilence=10
silencethreshold=128
maxlogins=3
sendvoicemail=yes
directory=/etc/asterisk/vm
EOT

	vm_n=0
	gen_vm() {
		local num pw
		config_get num "$1" number
		[ -z "$num" ] && return 0
		vm_n=$((vm_n + 1))
		# 100 -> 1000, 101 -> 1001, ...: the stock voicemail layout.
		pw=$((1000 + vm_n - 1))
		echo "$num => $pw,Extension $num,"
	}
	echo "[main]"
	config_load ufivoice
	config_foreach gen_vm phone
	echo
} > /etc/asterisk/voicemail.conf

# /var/spool/asterisk is on tmpfs (OpenWrt links /var -> /tmp), so messages
# left in it would be lost on reboot. Keep the mailbox spool on the overlay.
mkdir -p /etc/asterisk/vm/main
chown -R asterisk:asterisk /etc/asterisk/vm 2>/dev/null

# A running asterisk keeps the old mailboxes: it reads voicemail.conf only at
# module load, and neither "core reload" nor "dialplan reload" refreshes them.
if pidof asterisk >/dev/null 2>&1; then
	asterisk -rx "voicemail reload" >/dev/null 2>&1
	asterisk -rx "dialplan reload" >/dev/null 2>&1
fi

# --- manager.conf --------------------------------------------------------

cat > /etc/asterisk/manager.conf <<EOT
; ufi-voice: AMI for ufi-voiced, localhost only
; GENERATED by /usr/sbin/ufi-voice-asterisk-apply from /etc/config/ufivoice.
[general]
enabled=yes
port=5038
bindaddr=127.0.0.1

[ufivoice]
secret=$ami
deny=0.0.0.0/0.0.0.0
permit=127.0.0.1/255.255.255.255
read=call,system
write=call,originate,system
EOT

# --- credentials reminder -------------------------------------------------

umask 077
{
	echo "SIP server: this stick (UDP 5060)"
	gen_txt() {
		local num pw
		config_get num "$1" number
		config_get pw "$1" password
		[ -n "$num" ] && echo "user $num  password $pw"
	}
	config_load ufivoice
	config_foreach gen_txt phone
} > /etc/asterisk/ufi-voice-phones.txt

chown root:asterisk /etc/asterisk/pjsip.conf /etc/asterisk/manager.conf
chmod 640 /etc/asterisk/pjsip.conf /etc/asterisk/manager.conf
touch /etc/asterisk/.ufi-voice

uci -q set asterisk.general.enabled=1 && uci -q commit asterisk
# Enable the daemon so the SIP leg is up on a fresh image and after a runtime
# install; ufi-voiced connects to its AMI socket at start.
[ -x /etc/init.d/asterisk ] && /etc/init.d/asterisk enable
exit 0
